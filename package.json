{
  "name": "mt-point-map-gmt",
  "version": "1.11.0",
  "description": "MT点位图制作工具-GMT / Cross-platform GMT desktop tool for magnetotelluric station maps, EDI parsing, phase tensor, tipper, and MT sounding curves.",
  "main": "electron/main.js",
  "author": "CWN",
  "license": "MIT",
  "keywords": [
    "magnetotelluric",
    "gmt",
    "geophysics",
    "edi",
    "phase-tensor",
    "tipper",
    "apparent-resistivity",
    "earth-science",
    "mapping",
    "electron"
  ],
  "homepage": "https://github.com/SC123667/mt-point-map-gmt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SC123667/mt-point-map-gmt.git"
  },
  "bugs": {
    "url": "https://github.com/SC123667/mt-point-map-gmt/issues"
  },
  "scripts": {
    "start": "electron .",
    "test:node": "node tests/parser_edi.test.js && node tests/mt_math.test.js && node tests/mt_plots.test.js && node tests/fault_legend.test.js && node tests/import_worker.test.js && node tests/gmt_worker.test.js && node tests/srtm_worker.test.js && node tests/srtm_source.test.js && node tests/ui_workbench.test.js && node tests/base_map.test.js && node tests/vector_pdf.test.js && node tests/workspace_terrain.test.js && node tests/cartography.test.js && node tests/map_editing.test.js && node tests/local_structures.test.js && node tests/label_layout.test.js && node tests/gmt_engine.test.js",
    "dist:mac": "electron-builder --mac dmg dir",
    "patch:nsis": "node scripts/patch-nsis-install-section.js",
    "dist:win": "npm run patch:nsis && electron-builder --win nsis portable",
    "pack:mac": "electron-builder --mac dir",
    "pack:win": "npm run patch:nsis && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.cwn.mt-point-map-gmt",
    "productName": "MT点位图制作工具—GMT",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "sample_points.csv",
      "README.md",
      "VERSION",
      "CHANGELOG.md"
    ],
    "extraResources": [
      {
        "from": "sample_points.csv",
        "to": "sample_points.csv"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "win": {
      "executableName": "MTPointMapGMT",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "1.3.5",
    "fast-xml-parser": "5.11.1",
    "pdf-lib": "1.17.1",
    "shpjs": "6.2.0",
    "xlsx": "^0.18.5"
  }
}
