{
  "name": "mt-point-map-gmt",
  "version": "0.4.1",
  "description": "MT点位图制作工具—GMT：跨平台大地电磁野外点位图制图软件",
  "main": "electron/main.js",
  "author": "CWN",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg dir",
    "dist:win": "electron-builder --win nsis portable",
    "pack:mac": "electron-builder --mac dir",
    "pack:win": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.cwn.mt-point-map-gmt",
    "productName": "MT点位图制作工具—GMT",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "sample_points.csv",
      "README.md",
      "VERSION",
      "CHANGELOG.md"
    ],
    "extraResources": [
      {
        "from": "sample_points.csv",
        "to": "sample_points.csv"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
